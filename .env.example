# =============================================================================
# Igloo Himalaya Treks — CMS & Backend Environment Configuration
# Copy this file to .env and replace placeholder secrets before running.
# =============================================================================

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (Prisma + connect-pg-simple session store)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/igloo_cms?schema=public"

# Session signing secret (use at least 32 random bytes in production)
SESSION_SECRET="replace-with-a-long-random-hex-secret-at-least-32-chars"
SESSION_MAX_AGE_MS=604800000

# Cookie security (set true when serving over HTTPS in production)
COOKIE_SECURE=false

# Allowed CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:4000,https://www.igloohimalayatreks.com"

# Initial Super Admin seed credentials (change immediately after first login)
SEED_ADMIN_EMAIL="admin@igloohimalayatreks.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Surya Lama"

# Cloudinary credentials (used in Phase 2 Media Library & signed uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SMTP / Email notifications for inquiries (used in Phase 2)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Igloo Himalaya Treks <info@igloohimalayatreks.com>"
MAIL_TO_INQUIRIES="info@igloohimalayatreks.com"
