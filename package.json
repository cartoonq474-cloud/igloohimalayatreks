{
  "name": "igloo-himalaya-treks",
  "version": "1.0.0",
  "description": "Igloo Himalaya Treks - Premier Himalayan Trekking & Expedition Website",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "start": "node scripts/dev-server.js",
    "serve": "node scripts/dev-server.js",
    "open": "node scripts/dev-server.js --open",
    "build": "node scripts/build.js",
    "vercel-build": "npx prisma generate && npm run build",
    "cms:dev": "node --watch-path=server server/index.js",
    "cms:start": "node server/index.js",
    "prisma:generate": "node scripts/run_with_env.js npx prisma generate",
    "prisma:push": "node scripts/run_with_env.js npx prisma db push",
    "prisma:migrate": "node scripts/run_with_env.js npx prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "test:backend": "node scripts/run_with_env.js node --test server/tests/*.test.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "nepal",
    "trekking",
    "himalayas",
    "everest",
    "annapurna"
  ],
  "author": "Igloo Himalaya Treks",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.11.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "supertest": "^7.3.2"
  }
}
