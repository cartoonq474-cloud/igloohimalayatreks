{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "includeFiles": "{server/**,prisma/**,components/**,data/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/server/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/prisma/(.*)",
      "destination": "/api/index"
    }
  ]
}
